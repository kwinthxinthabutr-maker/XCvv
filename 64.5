	nameLbl.Text = fruitInfo.Name
	nameLbl.Font = Enum.Font.GothamBlack
	nameLbl.TextScaled = true
	nameLbl.TextColor3 = fruitInfo.Color
	nameLbl.TextStrokeTransparency = 0.1
