local EffectsFolder = Workspace:FindFirstChild("BrickStudioEffects")
if not EffectsFolder then
	EffectsFolder = Instance.new("Folder")
	EffectsFolder.Name = "BrickStudioEffects"
	EffectsFolder.Parent = Workspace
end

local function Spawn3DDropEffect(dropType, labelText)
	local _, hrp, _ = GetSafeCharacter()
	if not hrp then return end

	if #EffectsFolder:GetChildren() > 45 then
		local first = EffectsFolder:GetChildren()[1]
		if first then first:Destroy() end
	end

	for i = 1, 3 do
		local p = Instance.new("Part")
		p.Name = dropType .. "Visual"
		p.Size = Vector3.new(1.3, 1.3, 1.3)
		p.Anchored = true
		p.CanCollide = false
		p.Material = Enum.Material.Neon

		if dropType == "Gem" then
			p.Color = Color3.fromRGB(45, 210, 255)
			p.Shape = Enum.PartType.Block
		elseif dropType == "Coins" then
			p.Color = Color3.fromRGB(255, 205, 45)
			p.Shape = Enum.PartType.Cylinder
		else
			p.Color = Color3.fromRGB(110, 255, 130)
			p.Shape = Enum.PartType.Ball
		end

		local offset = Vector3.new(math.random(-7, 7), math.random(2, 5), math.random(-7, 7))
		p.CFrame = hrp.CFrame * CFrame.new(offset) * CFrame.Angles(math.rad(45), math.rad(i * 60), 0)
		p.Parent = EffectsFolder

		if i == 1 then
			local bg = Instance.new("BillboardGui")
			bg.Size = UDim2.new(0, 150, 0, 42)
			bg.StudsOffset = Vector3.new(0, 2.2, 0)
			bg.AlwaysOnTop = true
			bg.Parent = p

			local txt = Instance.new("TextLabel")
			txt.Size = UDim2.new(1, 0, 1, 0)
			txt.BackgroundTransparency = 1
			txt.Text = "+" .. labelText
			txt.Font = Enum.Font.GothamBlack
			txt.TextScaled = true
			txt.TextColor3 = p.Color
			txt.TextStrokeTransparency = 0.15
			txt.Parent = bg
		end

		TweenService:Create(p, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			CFrame = hrp.CFrame,
			Size = Vector3.new(0.2, 0.2, 0.2),
			Transparency = 0.85
		}):Play()
		Debris:AddItem(p, 0.65)
	end
end

