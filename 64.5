-- สแกนหาเกาะและจุด Spawn จริงใน Workspace
local function ScanWorkspaceIslands()
	table.clear(State.CachedIslands)
	for _, wp in ipairs(MAP_WAYPOINTS) do
		table.insert(State.CachedIslands, wp)
	end

	local mapFolders = {
		Workspace:FindFirstChild("Map"),
		Workspace:FindFirstChild("Islands"),
		Workspace:FindFirstChild("World"),
		Workspace:FindFirstChild("Areas"),
		Workspace:FindFirstChild("Spawns"),
	}

	for _, folder in ipairs(mapFolders) do
		if folder then
			for _, child in ipairs(folder:GetChildren()) do
				local pos = nil
				if child:IsA("Model") then
					local ok, pivot = pcall(function() return child:GetPivot().Position end)
					if ok then pos = pivot end
				elseif child:IsA("BasePart") then
					pos = child.Position
				end
				if pos then
					table.insert(State.CachedIslands, {
						Name = "พบในแมพ: " .. child.Name,
						Position = pos
					})
				end
			end
		end
	end
end

-- ค้นหามอนสเตอร์ที่ใกล้ที่สุดสำหรับโหมด Auto Farm
local function FindNearestAliveMob()
	local _, hrp, _ = GetSafeCharacter()
	if not hrp then return nil end

	local nearestMob = nil
	local shortestDist = math.huge

	local mobContainers = {
		Workspace:FindFirstChild("Enemies"),
		Workspace:FindFirstChild("Mobs"),
		Workspace:FindFirstChild("NPCs"),
		Workspace:FindFirstChild("Bosses"),
		Workspace
	}

	for _, container in ipairs(mobContainers) do
		if container then
			for _, obj in ipairs(container:GetChildren()) do
				if obj:IsA("Model") and obj ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(obj) then
					local mobHum = obj:FindFirstChildOfClass("Humanoid")
					local mobRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
					if mobHum and mobRoot and mobHum.Health > 0 then
						local d = (hrp.Position - mobRoot.Position).Magnitude
						if d < shortestDist and d < 2500 then
							shortestDist = d
							nearestMob = mobRoot
						end
					end
				end
			end
		end
	end
	return nearestMob
end

