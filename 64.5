-- 3. ฟังก์ชันตรวจสอบตัวละครและจัดการข้อมูลฝั่งผู้เล่น/เซิร์ฟเวอร์ (Safe Helpers)
-- ============================================================================
local LocalPlayer = Players.LocalPlayer

local function GetSafeCharacter()
	if not LocalPlayer then return nil, nil, nil end
	local char = LocalPlayer.Character
	if not char then return nil, nil, nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return nil, nil, nil
	end
	return char, hrp, hum
end

local function FormatShort(n)
	if n >= 1e9 then
		return string.format("%.2fB", n / 1e9)
	elseif n >= 1e6 then
		return string.format("%.1fM", n / 1e6)
	elseif n >= 1e3 then
		return string.format("%.1fK", n / 1e3)
	end
	return tostring(math.floor(n))
end

-- สร้างหรือเชื่อมต่อโฟลเดอร์ข้อมูลผู้เล่น (ทำงานร่วมกับ leaderstats ของแมพจริง)
local function EnsurePlayerContainers()
	if not LocalPlayer then return nil, nil, nil end

	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = LocalPlayer
	end

	local gems = leaderstats:FindFirstChild("Gems") or leaderstats:FindFirstChild("Gem")
	if not gems then
		gems = Instance.new("NumberValue")
		gems.Name = "Gems"
		gems.Value = 500
		gems.Parent = leaderstats
	end

	local coins = leaderstats:FindFirstChild("Coins") or leaderstats:FindFirstChild("Gold") or leaderstats:FindFirstChild("Beli")
	if not coins then
		coins = Instance.new("NumberValue")
		coins.Name = "Coins"
		coins.Value = 1500
		coins.Parent = leaderstats
	end

	local brickStats = LocalPlayer:FindFirstChild("BrickStats")
	if not brickStats then
		brickStats = Instance.new("Folder")
		brickStats.Name = "BrickStats"
		brickStats.Parent = LocalPlayer
	end

	local food = brickStats:FindFirstChild("Food")
	if not food then
		food = Instance.new("NumberValue")
		food.Name = "Food"
		food.Value = 100
		food.Parent = brickStats
	end

	local totalEff = brickStats:FindFirstChild("TotalEffect")
	if not totalEff then
		totalEff = Instance.new("NumberValue")
		totalEff.Name = "TotalEffect"
		totalEff.Value = 0.10
		totalEff.Parent = brickStats
	end

	local fruitInv = LocalPlayer:FindFirstChild("FruitInventory")
	if not fruitInv then
		fruitInv = Instance.new("Folder")
		fruitInv.Name = "FruitInventory"
		fruitInv.Parent = LocalPlayer

		-- เริ่มต้นมี Bomb Lv.1 เหมือนในคลิป
		local starter = Instance.new("IntValue")
		starter.Name = "Bomb"
		starter.Value = 1
		starter:SetAttribute("Level", 1)
		starter:SetAttribute("Rarity", "Common")
		starter:SetAttribute("BaseEffect", 0.10)
		starter.Parent = fruitInv
	end

	return leaderstats, brickStats, fruitInv
end

local function RecalculateTotalEffect()
	local _, brickStats, fruitInv = EnsurePlayerContainers()
	if not brickStats or not fruitInv then return 0 end

	local sumBonus = 0
	for _, item in ipairs(fruitInv:GetChildren()) do
		local lvl = item:GetAttribute("Level") or 1
		local base = item:GetAttribute("BaseEffect") or 0.10
		sumBonus = sumBonus + (lvl * base)
	end

	local totalEff = brickStats:FindFirstChild("TotalEffect")
	if totalEff then
		totalEff.Value = math.floor(sumBonus * 100) / 100
	end
	return sumBonus
end

