-- ลูปทำงานอัตโนมัติ (Auto Gem/Coins, Auto Summon, Auto Farm, Auto Collect)
task.spawn(function()
	while State.IsRunning do
		if State.AutoInfGem then
			pcall(ExecuteGemAction)
		end
		if State.AutoInfCoins then
			pcall(ExecuteCoinsAction)
		end
		if State.AutoSummon500 then
			pcall(function() ExecuteSummonAction(500) end)
		end

		-- โหมด Auto Farm มอนสเตอร์
		if State.AutoFarmMob then
			local char, hrp, _ = GetSafeCharacter()
			local mobRoot = FindNearestAliveMob()
			if char and hrp and mobRoot then
				hrp.CFrame = mobRoot.CFrame * CFrame.new(0, 4.5, 3.5)
				local tool = char:FindFirstChildOfClass("Tool")
				if tool then
					pcall(function() tool:Activate() end)
				end
			end
		end

		-- โหมดเก็บผลไม้และกล่องสมบัติในแมพ
		if State.AutoCollectDrops then
			local _, hrp, _ = GetSafeCharacter()
			if hrp then
				for _, child in ipairs(Workspace:GetChildren()) do
					local lower = string.lower(child.Name)
					if string.find(lower, "fruit") or string.find(lower, "chest") or string.find(lower, "box") then
						local handle = child:IsA("BasePart") and child or child:FindFirstChild("Handle") or child:FindFirstChildWhichIsA("BasePart")
						if handle then
							pcall(function()
								handle.CFrame = hrp.CFrame
							end)
						end
					end
				end
			end
		end

		task.wait(0.35)
	end
end)

