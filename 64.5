RefreshInventoryCallback = function()
	local _, _, fruitInv = EnsurePlayerContainers()
	if not fruitInv then return end
	local items = fruitInv:GetChildren()
	table.sort(items, function(a, b)
		return (a:GetAttribute("Level") or 1) > (b:GetAttribute("Level") or 1)
	end)

	local lines = { "กระเป๋าผลไม้ของคุณ (Fruit Inventory):" }
	for _, it in ipairs(items) do
		local lvl = it:GetAttribute("Level") or 1
		local rar = it:GetAttribute("Rarity") or "Common"
		local base = it:GetAttribute("BaseEffect") or 0.1
		table.insert(lines, string.format("• %s [Lv.%d] x%d (%s) -> +%.1f%%", it.Name, lvl, it.Value, rar, lvl * base))
	end
	BagDisplay.Text = table.concat(lines, "\n")
end

