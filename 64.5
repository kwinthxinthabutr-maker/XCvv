-- 7. ระบบนำทาง Tween และสแกนแมพ Anime Fruit! อัตโนมัติ (Map & Auto Farm)
-- ============================================================================
local function SmoothTweenTo(targetPosition, labelName)
	local _, hrp, _ = GetSafeCharacter()
	if not hrp then
		Notify("Error", "ตัวละครยังโหลดไม่เสร็จ", false)
		return
	end

	if State.ActiveTween then
		pcall(function() State.ActiveTween:Cancel() end)
		State.ActiveTween = nil
	end

	pcall(function()
		LocalPlayer:RequestStreamAroundAsync(targetPosition)
	end)

	local dist = (hrp.Position - targetPosition).Magnitude
	local duration = math.clamp(dist / 190, 0.3, 3.2)

	local tw = TweenService:Create(
		hrp,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ CFrame = CFrame.new(targetPosition + Vector3.new(0, 3.5, 0)) }
	)
	State.ActiveTween = tw
	tw:Play()

	if labelName then
