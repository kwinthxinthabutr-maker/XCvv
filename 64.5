-- 4. ระบบสแกนและยิง Remote เซิร์ฟเวอร์อัตโนมัติ (Server-Client Remote Bridge)
-- ============================================================================
local function ScanGameRemotes()
	table.clear(State.CachedRemotes)
	local searchRoots = { ReplicatedStorage }
	if LocalPlayer then
		table.insert(searchRoots, LocalPlayer)
	end

	for _, root in ipairs(searchRoots) do
		pcall(function()
			for _, desc in ipairs(root:GetDescendants()) do
				if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") then
					table.insert(State.CachedRemotes, desc)
				end
			end
		end)
	end
end

-- ยิงคำสั่งไปยัง Remote ของเซิร์ฟเวอร์ที่ตรงกับคีย์เวิร์ดของแมพ Anime Fruit!
local function DispatchServerPayload(actionCategory, arg1, arg2)
	-- 1. หากมี BrickStudioRemotes (โหมด Server-Side เต็มรูปแบบ) ให้ยิงตรงทันที
	local customFolder = ReplicatedStorage:FindFirstChild("BrickStudioRemotes")
	if customFolder then
		local actionRemote = customFolder:FindFirstChild("BrickStudioAction")
		if actionRemote and actionRemote:IsA("RemoteEvent") then
			pcall(function()
				actionRemote:FireServer(actionCategory, arg1, arg2)
			end)
		end
	end

	-- 2. สแกนและส่ง Payload ไปยัง RemoteEvent ของแมพ Anime Fruit! ที่เกี่ยวข้อง
	local keywords = {
		["Gem"] = { "gem", "diamond", "currency", "reward", "add", "claim", "gift", "payload" },
		["Coins"] = { "coin", "gold", "beli", "money", "cash", "currency", "reward", "add" },
		["Food"] = { "food", "feed", "berry", "exp", "fruit", "item", "add" },
		["Summon"] = { "summon", "roll", "spin", "draw", "gacha", "chest", "buy", "fruit" },
		["FeedSelected"] = { "feed", "upgrade", "level", "lvl", "enhance", "eat", "fruit" },
		["MaxAll"] = { "max", "upgradeall", "feedall", "level", "lvl", "equip" },
	}

	local targetKeys = keywords[actionCategory] or { string.lower(actionCategory) }
	for _, remote in ipairs(State.CachedRemotes) do
		if remote and remote.Parent and remote:IsA("RemoteEvent") then
			local lowerName = string.lower(remote.Name)
			for _, kw in ipairs(targetKeys) do
				if string.find(lowerName, kw, 1, true) then
					task.spawn(function()
						pcall(function()
							remote:FireServer(arg1, arg2, State.SelectedPayload)
						end)
					end)
					break
				end
			end
		end
	end
end

