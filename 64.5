-- 6. ฟังก์ชันดำเนินการหลักของระบบ Get และ Lvl (Core Actions)
-- ============================================================================
local ToastCallback = nil
local RefreshInventoryCallback = nil

local function Notify(title, msg, isSuccess)
	if ToastCallback then
		ToastCallback(title, msg, isSuccess)
	end
end

local function ExecuteGemAction()
	local leaderstats = EnsurePlayerContainers()
	local mult = PAYLOAD_MULTIPLIERS[State.SelectedPayload] or 25
	local addGem = math.floor(99800 * (mult / 25))
	if addGem < 99800 then addGem = 99800 end

	DispatchServerPayload("Gem", addGem, State.SelectedPayload)

	local gemObj = leaderstats and (leaderstats:FindFirstChild("Gems") or leaderstats:FindFirstChild("Gem"))
	if gemObj then
		gemObj.Value = gemObj.Value + addGem
	end
	Spawn3DDropEffect("Gem", FormatShort(addGem))
	Notify("Success", "Gem Action (+" .. FormatShort(addGem) .. ")", true)
end

local function ExecuteCoinsAction()
	local leaderstats = EnsurePlayerContainers()
	local mult = PAYLOAD_MULTIPLIERS[State.SelectedPayload] or 25
	local addCoins = math.floor(100000000 * (mult / 25))
	if addCoins < 100000000 then addCoins = 100000000 end

	DispatchServerPayload("Coins", addCoins, State.SelectedPayload)

	local coinObj = leaderstats and (leaderstats:FindFirstChild("Coins") or leaderstats:FindFirstChild("Gold") or leaderstats:FindFirstChild("Beli"))
	if coinObj then
		coinObj.Value = coinObj.Value + addCoins
	end
	Spawn3DDropEffect("Coins", FormatShort(addCoins))
	Notify("Success", "Coins Action (+" .. FormatShort(addCoins) .. ")", true)
end

local function ExecuteFoodAction()
	local _, brickStats = EnsurePlayerContainers()
	local mult = PAYLOAD_MULTIPLIERS[State.SelectedPayload] or 25
	local addFood = 250 * mult

	DispatchServerPayload("Food", addFood, State.SelectedPayload)

	local foodObj = brickStats and brickStats:FindFirstChild("Food")
	if foodObj then
		foodObj.Value = foodObj.Value + addFood
	end
	Spawn3DDropEffect("Food", FormatShort(addFood) .. " Food")
	Notify("Success", "Food Action (+" .. FormatShort(addFood) .. ")", true)
end

local function ExecuteSummonAction(costTier)
	local leaderstats, _, fruitInv = EnsurePlayerContainers()
	if not fruitInv then return end

	DispatchServerPayload("Summon", costTier, State.SelectedPayload)

	local gemObj = leaderstats and (leaderstats:FindFirstChild("Gems") or leaderstats:FindFirstChild("Gem"))
	if gemObj and gemObj.Value >= costTier then
		gemObj.Value = gemObj.Value - costTier
	end

	local rolls = (costTier == 500 and 5) or (costTier == 300 and 3) or 1
	local lastFruit = FRUIT_DATABASE[1]

	for _ = 1, rolls do
		-- สุ่มผลไม้โดยเพิ่มโอกาสได้ระดับ Mythical/Legendary เมื่อสุ่ม 500
		local maxIndex = (costTier == 500 and 6) or #FRUIT_DATABASE
		local picked = FRUIT_DATABASE[math.random(1, maxIndex)]
		lastFruit = picked

		local item = fruitInv:FindFirstChild(picked.Name)
		if not item then
			item = Instance.new("IntValue")
			item.Name = picked.Name
			item.Value = 1
			item:SetAttribute("Level", 1)
			item:SetAttribute("Rarity", picked.Rarity)
			item:SetAttribute("BaseEffect", picked.BaseEffect)
			item.Parent = fruitInv
		else
			item.Value = item.Value + 1
		end
	end

	RecalculateTotalEffect()
	Spawn3DSummonChest(lastFruit)
	if RefreshInventoryCallback then RefreshInventoryCallback() end
	Notify("Success", "Summon " .. tostring(costTier) .. ": ได้รับ " .. lastFruit.Name .. " [" .. lastFruit.Rarity .. "]", true)
end

local function ExecuteFeedSelected()
	local _, _, fruitInv = EnsurePlayerContainers()
	if not fruitInv then return end

	local targetName = State.SelectedFruit
	DispatchServerPayload("FeedSelected", targetName, 200)

	local info = FRUIT_LOOKUP[targetName] or FRUIT_DATABASE[1]
	local item = fruitInv:FindFirstChild(targetName)
	if not item then
		item = Instance.new("IntValue")
		item.Name = targetName
		item.Value = 1
		item:SetAttribute("Level", 1)
		item:SetAttribute("Rarity", info.Rarity)
		item:SetAttribute("BaseEffect", info.BaseEffect)
		item.Parent = fruitInv
	end

	local curLvl = item:GetAttribute("Level") or 1
	local nextLvl = math.min(200, curLvl + 25)
	item:SetAttribute("Level", nextLvl)

	RecalculateTotalEffect()
	if RefreshInventoryCallback then RefreshInventoryCallback() end
	Notify("Success", "Feed Action: " .. targetName .. " อัปเป็น Lv." .. tostring(nextLvl), true)
end

local function ExecuteMaxAllFruits()
	local _, _, fruitInv = EnsurePlayerContainers()
	if not fruitInv then return end

	DispatchServerPayload("MaxAll", 200, State.SelectedPayload)

	for _, info in ipairs(FRUIT_DATABASE) do
		local item = fruitInv:FindFirstChild(info.Name)
		if not item then
			item = Instance.new("IntValue")
			item.Name = info.Name
			item.Value = 1
			item:SetAttribute("Rarity", info.Rarity)
			item:SetAttribute("BaseEffect", info.BaseEffect)
			item.Parent = fruitInv
		end
		item:SetAttribute("Level", 200)
	end

	RecalculateTotalEffect()
	if RefreshInventoryCallback then RefreshInventoryCallback() end
	Notify("Success", "Max All Action: ผลไม้ทุกชนิดเป็น Lv.200 ตันทั้งหมด!", true)
end

