local function isPlayerMonster(plr)
    local function scanTools(container)
        if not container then return nil end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local ln = string.lower(item.Name)
                for _, kw in ipairs(BrickStudioConfig.AttackKeywords) do
                    if string.find(ln, kw) then
                        return item.Name
                    end
                end
            end
        end
        return nil
    end

    local foundWeapon = scanTools(plr.Character) or scanTools(plr:FindFirstChild("Backpack"))
    if foundWeapon then
        return true, "ถืออาวุธ [" .. foundWeapon .. "]"
    end

    if plr.Team then
        local tn = string.lower(plr.Team.Name)
        for _, kw in ipairs(BrickStudioConfig.MonsterKeywords) do
            if string.find(tn, kw) then
                return true, "ทีมตัวประหลาด"
            end
        end
    end

    for k, v in pairs(plr:GetAttributes()) do
        local combined = string.lower(tostring(k) .. tostring(v))
        for _, kw in ipairs(BrickStudioConfig.MonsterKeywords) do
            if string.find(combined, kw) and v ~= false then
                return true, "สถานะตัวประหลาด"
            end
        end
    end

    for _, valObj in ipairs(plr:GetDescendants()) do
        if valObj:IsA("StringValue") then
            local vLower = string.lower(valObj.Value)
            for _, kw in ipairs(BrickStudioConfig.MonsterKeywords) do
                if string.find(vLower, kw) then
                    return true, "บทบาท [" .. valObj.Value .. "]"
                end
            end
        elseif valObj:IsA("BoolValue") and valObj.Value == true then
            local nLower = string.lower(valObj.Name)
            for _, kw in ipairs(BrickStudioConfig.MonsterKeywords) do
                if string.find(nLower, kw) then
                    return true, "สถานะ [" .. valObj.Name .. "]"
                end
            end
        end
    end

    if plr.Character then
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.HipHeight > 3.2 then
            return true, "ร่าง The Locust"
        end
        for _, child in ipairs(plr.Character:GetChildren()) do
            local cn = string.lower(child.Name)
            for _, kw in ipairs(BrickStudioConfig.MonsterKeywords) do
                if string.find(cn, kw) then
                    return true, "ร่างจำแลง [" .. child.Name .. "]"
                end
            end
        end
    end

    return false, ""
end

local function isNPCMonsterModel(obj)
    if not obj:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end

    local ln = string.lower(obj.Name)
    for _, kw in ipairs(BrickStudioConfig.MonsterKeywords) do
        if string.find(ln, kw) then
            return true
        end
    end

    local hasControl = obj:FindFirstChildOfClass("Humanoid") or obj:FindFirstChildOfClass("AnimationController")
    local hasRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso")
    if hasControl and hasRoot then
        return true
    end
    return false
end

-- ตรวจสอบว่าวัตถุเป็น หัวฟักทอง / กุญแจ / เหรียญ หรือไม่
local function classifyMapItem(obj)
    if not obj or not obj:IsDescendantOf(Workspace) then return nil end
    if not (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Tool")) then return nil end
    if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) then return nil end

    -- ข้ามชิ้นส่วนในตัวผู้เล่น
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and obj:IsDescendantOf(plr.Character) then
            return nil
        end
    end

    -- ป้องกันการจับซ้ำถ้า Parent เป็น Model ชื่อเดียวกันอยู่แล้ว
    if obj:IsA("BasePart") and obj.Parent and (obj.Parent:IsA("Model") or obj.Parent:IsA("Tool")) and obj.Parent ~= Workspace then
        local parentName = string.lower(obj.Parent.Name)
        for _, list in ipairs({BrickStudioConfig.PumpkinKeywords, BrickStudioConfig.KeyKeywords, BrickStudioConfig.CoinKeywords}) do
            for _, kw in ipairs(list) do
                if string.find(parentName, kw) then
                    return nil -- ให้จับที่ตัว Model/Tool หลักแทน
                end
            end
        end
    end

    local nameLower = string.lower(obj.Name)
    local hasInteract = obj:FindFirstChildWhichIsA("TouchTransmitter", true)
        or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        or obj:FindFirstChildWhichIsA("ClickDetector", true)
        or obj:IsA("Tool")
        or obj:IsA("MeshPart")
        or obj:FindFirstChildWhichIsA("SpecialMesh", true)

    if not hasInteract then return nil end
    if not getRootPart(obj) then return nil end

    -- 1. เช็คหัวฟักทองฮาโลวีน
    for _, kw in ipairs(BrickStudioConfig.PumpkinKeywords) do
        if string.find(nameLower, kw) then
            return "Pumpkin"
        end
    end

    -- 2. เช็คกุญแจและไอเทมเปิดทาง
    for _, kw in ipairs(BrickStudioConfig.KeyKeywords) do
        if string.find(nameLower, kw) then
            return "Key"
        end
    end

    -- 3. เช็คเหรียญและของดรอป
    for _, kw in ipairs(BrickStudioConfig.CoinKeywords) do
        if string.find(nameLower, kw) then
            return "Coin"
        end
    end

    return nil
end

local function rescanMapObjects()
    local newMonsters = {}
    local newPumpkins = {}
    local newKeys = {}
    local newCoins = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("Model") and isNPCMonsterModel(obj) then
                table.insert(newMonsters, obj)
            else
                local itemType = classifyMapItem(obj)
                if itemType == "Pumpkin" then
                    table.insert(newPumpkins, obj)
                elseif itemType == "Key" then
                    table.insert(newKeys, obj)
                elseif itemType == "Coin" then
                    table.insert(newCoins, obj)
                end
            end
        end)
    end

    CachedMonsters = newMonsters
    CachedPumpkins = newPumpkins
    CachedKeys = newKeys
    CachedCoins = newCoins
end

-- ฟังก์ชันอัปเดต ESP ทั้งหมดแบบทันที
local function refreshAllESPNow()
    local closestMonsterDist = math.huge
    local closestMonsterName = "ไม่พบในระยะ"
    local validTargets = {}

    -- 1. ผู้เล่น & ตัวประหลาดที่เป็นผู้เล่น
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:IsDescendantOf(Workspace) then
            pcall(function()
                local char = plr.Character
                local isMonster, reason = isPlayerMonster(plr)
                if isMonster then
                    if BrickStudioConfig.ESP.MonsterESP then
                        validTargets[char] = true
                        renderHybridESP(
                            char,
                            "Monster",
                            "👹 ไอ้ตัวประหลาด: " .. plr.Name .. " (" .. reason .. ")",
                            BrickStudioConfig.Colors.MonsterFill,
                            BrickStudioConfig.Colors.MonsterOutline,
                            BrickStudioConfig.ESP.MonsterTracer
                        )
                    else
                        removeESPObject(char)
                    end

                    local root = getRootPart(char)
                    local myRoot = LocalPlayer.Character and getRootPart(LocalPlayer.Character)
                    if root and myRoot then
                        local d = math.floor((myRoot.Position - root.Position).Magnitude)
                        if d < closestMonsterDist then
                            closestMonsterDist = d
                            closestMonsterName = plr.Name
                        end
                    end
                else
                    if BrickStudioConfig.ESP.PlayerESP then
                        validTargets[char] = true
                        renderHybridESP(
                            char,
                            "Player",
                            "👤 ผู้เล่น: " .. plr.Name,
                            BrickStudioConfig.Colors.PlayerFill,
                            BrickStudioConfig.Colors.PlayerOutline,
                            false
                        )
                    else
                        removeESPObject(char)
                    end
                end
            end)
        end
    end

    -- 2. ตัวประหลาดที่เป็น NPC
    for _, npc in ipairs(CachedMonsters) do
        if npc and npc:IsDescendantOf(Workspace) then
            pcall(function()
                if BrickStudioConfig.ESP.MonsterESP then
                    validTargets[npc] = true
                    renderHybridESP(
                        npc,
                        "Monster",
                        "👹 ไอ้ตัวประหลาด [" .. npc.Name .. "]",
                        BrickStudioConfig.Colors.MonsterFill,
                        BrickStudioConfig.Colors.MonsterOutline,
                        BrickStudioConfig.ESP.MonsterTracer
                    )
                else
                    removeESPObject(npc)
                end

                local root = getRootPart(npc)
                local myRoot = LocalPlayer.Character and getRootPart(LocalPlayer.Character)
                if root and myRoot then
                    local d = math.floor((myRoot.Position - root.Position).Magnitude)
                    if d < closestMonsterDist then
                        closestMonsterDist = d
                        closestMonsterName = npc.Name
                    end
                end
            end)
        end
    end

    -- 3. หัวฟักทองฮาโลวีน
    if BrickStudioConfig.ESP.PumpkinESP then
        for _, pumpkin in ipairs(CachedPumpkins) do
            if pumpkin and pumpkin:IsDescendantOf(Workspace) then
                pcall(function()
                    validTargets[pumpkin] = true
                    renderHybridESP(
                        pumpkin,
                        "Pumpkin",
                        "🎃 หัวฟักทอง [" .. pumpkin.Name .. "]",
                        BrickStudioConfig.Colors.PumpkinFill,
                        BrickStudioConfig.Colors.PumpkinOutline,
                        false
                    )
                end)
            end
        end
    end

    -- 4. กุญแจและเหรียญ
    if BrickStudioConfig.ESP.KeyAndCoinESP then
        for _, keyObj in ipairs(CachedKeys) do
            if keyObj and keyObj:IsDescendantOf(Workspace) then
                pcall(function()
                    validTargets[keyObj] = true
                    renderHybridESP(
                        keyObj,
                        "KeyCoin",
                        "🔑 กุญแจ/ไอเทมสำคัญ [" .. keyObj.Name .. "]",
                        BrickStudioConfig.Colors.KeyFill,
                        BrickStudioConfig.Colors.KeyOutline,
                        BrickStudioConfig.ESP.KeyTracer
                    )
                end)
            end
        end

        for _, coinObj in ipairs(CachedCoins) do
            if coinObj and coinObj:IsDescendantOf(Workspace) then
                pcall(function()
                    validTargets[coinObj] = true
                    renderHybridESP(
                        coinObj,
                        "KeyCoin",
                        "💰 เหรียญ/โบนัส [" .. coinObj.Name .. "]",
                        BrickStudioConfig.Colors.CoinFill,
                        BrickStudioConfig.Colors.CoinOutline,
                        false
                    )
                end)
            end
        end
    end

    -- ล้าง ESP ของวัตถุที่ถูกเก็บไปแล้วหรือถูกปิดสวิตช์
    for target, _ in pairs(ActiveESPRegistry) do
        if not validTargets[target] or not target:IsDescendantOf(Workspace) then
            removeESPObject(target)
        end
    end

    -- อัปเดตแถบเรดาร์ด้านบนหน้าจอ
    if BrickStudioConfig.ESP.DangerRadar then
        local pCount = #CachedPumpkins
        local kCount = #CachedKeys
        if closestMonsterDist < math.huge then
            if closestMonsterDist <= 45 then
                RadarStroke.Color = Color3.fromRGB(255, 0, 50)
                RadarLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
                RadarLabel.Text = string.format("🚨 อันตราย! [%s] ห่าง %d ม. | 🎃 ฟักทอง: %d | 🔑 กุญแจ: %d", closestMonsterName, closestMonsterDist, pCount, kCount)
            else
                RadarStroke.Color = Color3.fromRGB(0, 255, 140)
                RadarLabel.TextColor3 = Color3.fromRGB(220, 255, 225)
                RadarLabel.Text = string.format("👹 [%s]: %d ม. | 🎃 ฟักทอง: %d | 🔑 กุญแจ: %d", closestMonsterName, closestMonsterDist, pCount, kCount)
            end
        else
            RadarStroke.Color = Color3.fromRGB(0, 200, 255)
            RadarLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            RadarLabel.Text = string.format("🟢 ปลอดภัย | 🎃 หัวฟักทอง: %d | 🔑 กุญแจ: %d | 💰 เหรียญ: %d", pCount, kCount, #CachedCoins)
        end
    end

    return closestMonsterDist
end

