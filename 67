        if BrickStudioConfig.ServerSignals.AutoSignal4_RoundState then
            pcall(triggerServerSignal4_RoundState, true)
        end

        -- ระบบเสริมฝั่งเซิร์ฟเวอร์
        if BrickStudioConfig.ServerSignals.HitboxExpander then
            pcall(applyHitboxExpander, true)
        end
        if BrickStudioConfig.ServerSignals.ReplayLastRemote and LastCapturedRemote then
            pcall(function()
                LastCapturedRemote:FireServer(table.unpack(LastCapturedArgs))
            end)
        end
        if BrickStudioConfig.ServerSignals.AutoFireCustom then
            pcall(fireSelectedCustomRemote)
        end

        task.wait(0.85)
    end
end)

-- ลูปหลักสำหรับอัปเดต Ultra ESP V5 และระบบหลบตัวประหลาดอัตโนมัติ
task.spawn(function()
    while BrickStudioConfig.Running do
        pcall(function()
            if BrickStudioConfig.ESP.Fullbright then
                applyFullbright(true)
            end

            local closestMonsterDist = refreshAllESPNow()

            if BrickStudioConfig.ServerSignals.AutoDodgeMonster and closestMonsterDist <= BrickStudioConfig.ServerSignals.DodgeDistance then
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    myRoot.CFrame = myRoot.CFrame * CFrame.new(math.random(-18, 18), 8, -22)
                end
            end
        end)
        task.wait(0.2)
    end
end)

-- ฟังก์ชันทำความสะอาดเมื่อรันสคริปต์ซ้ำ
_G.BrickStudio_Cleanup = function()
    BrickStudioConfig.Running = false
    pcall(function() HeartbeatConn:Disconnect() end)
    pcall(function() SteppedConn:Disconnect() end)
    pcall(function() JumpConn:Disconnect() end)
    clearESPCategory(nil)
    if ESPContainer then pcall(function() ESPContainer:Destroy() end) end
    if RadarScreen then pcall(function() RadarScreen:Destroy() end) end
end
