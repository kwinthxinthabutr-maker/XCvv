-- ============================================================================
local DiscoveredRemotes = {}
local RemoteNamesList = {}
local ConnectedListeners = {}
local LastCapturedRemote = nil
local LastCapturedArgs = {}
local SafeZoneSavedCFrame = nil

local function fireMatchingRemotes(keywords, ...)
    local args = {...}
    local count = 0
    for _, rem in pairs(DiscoveredRemotes) do
        if rem and rem:IsA("RemoteEvent") then
            local ln = string.lower(rem.Name)
            for _, kw in ipairs(keywords) do
                if string.find(ln, kw) then
                    pcall(function()
                        rem:FireServer(table.unpack(args))
                    end)
                    count += 1
                    break
                end
            end
        end
    end
    return count
end

-- ฟังก์ชันส่งสัญญาณไปเก็บวัตถุที่ระบุโดย "ไม่ต้องวาร์ปตัวละครของเรา"
local function sendServerSignalToCollectItem(itemObj)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not itemObj or not itemObj:IsDescendantOf(Workspace) then return false end

    local targetPart = getRootPart(itemObj)
    if not targetPart then return false end

    local env = (getfenv and getfenv()) or _G
    local fireTouch = env.firetouchinterest
    local firePrompt = env.fireproximityprompt
    local fireClick = env.fireclickdetector

    -- วิธีที่ 1: ส่งแพ็กเกจ TouchTransmitter ไปยังเซิร์ฟเวอร์โดยตรง
    pcall(function()
        if typeof(fireTouch) == "function" then
            fireTouch(myRoot, targetPart, 0)
            fireTouch(myRoot, targetPart, 1)
        end
        for _, desc in ipairs(itemObj:GetDescendants()) do
            if desc:IsA("TouchTransmitter") and desc.Parent and desc.Parent:IsA("BasePart") then
                if typeof(fireTouch) == "function" then
                    fireTouch(myRoot, desc.Parent, 0)
                    fireTouch(myRoot, desc.Parent, 1)
                end
            end
        end
    end)

    -- วิธีที่ 2: สั่งกด ProximityPrompt / ClickDetector บนตัวไอเทมจากระยะไกล
    pcall(function()
        local prompt = itemObj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            if typeof(firePrompt) == "function" then
                firePrompt(prompt)
            else
                prompt:InputHoldBegin()
                prompt:InputHoldEnd()
            end
        end
        local click = itemObj:FindFirstChildWhichIsA("ClickDetector", true)
        if click and typeof(fireClick) == "function" then
            fireClick(click)
        end
    end)

    -- วิธีที่ 3: ดึงฮิตบ็อกซ์ของไอเทมมาแตะตัวเราแบบเงียบๆ (ตัวเราไม่วาร์ปไปไหน)
    pcall(function()
        targetPart.CanCollide = false
        targetPart.CFrame = myRoot.CFrame
    end)

    -- วิธีที่ 4: ยิง RemoteEvent ที่อยู่ในตัวไอเทม (ถ้ามี)
    pcall(function()
        for _, rem in ipairs(itemObj:GetDescendants()) do
            if rem:IsA("RemoteEvent") then
                rem:FireServer()
                rem:FireServer(itemObj)
            end
        end
    end)

    return true
end

