-- วาร์ปไปเก็บ "หัวฟักทองฮาโลวีน" ทั้งหมดในแมพแล้วกลับจุดเดิม (แบบที่ 2: วาร์ปไปเก็บ)
local isTeleportFarmingPumpkins = false
local function collectAllPumpkinsByTeleport()
    if isTeleportFarmingPumpkins then return end
    isTeleportFarmingPumpkins = true

    pcall(function()
        rescanMapObjects()
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            sendBrickStudioNotification("❌ ไม่พบตัวละครของคุณบอส!", 3)
            isTeleportFarmingPumpkins = false
            return
        end

        if #CachedPumpkins == 0 then
            sendBrickStudioNotification("🎃 ไม่พบหัวฟักทองในแมพตอนนี้ครับคุณบอส", 3)
            isTeleportFarmingPumpkins = false
            return
        end

        local savedCF = myRoot.CFrame
        local count = 0
        sendBrickStudioNotification("🚀 กำลังวาร์ปไปเก็บหัวฟักทองทั้งหมด " .. tostring(#CachedPumpkins) .. " จุด...", 4)

        for _, pumpkin in ipairs(CachedPumpkins) do
            if pumpkin and pumpkin:IsDescendantOf(Workspace) then
                local part = getRootPart(pumpkin)
                if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 2, 0)
                    task.wait(0.12)
                    sendServerSignalToCollectItem(pumpkin)
                    count += 1
                    task.wait(0.08)
                end
            end
        end

        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = savedCF
        end

        sendBrickStudioNotification("✅ วาร์ปเก็บหัวฟักทองครบ " .. tostring(count) .. " จุด และกลับที่เดิมเรียบร้อย!", 4)
    end)

    isTeleportFarmingPumpkins = false
end

