                if not string.find(ln, "character") and not string.find(ln, "footstep") and not string.find(ln, "camera") then
                    LastCapturedRemote = self
                    LastCapturedArgs = {...}
                end
            end
            return oldNamecall(self, ...)
        end)
    end
end)

