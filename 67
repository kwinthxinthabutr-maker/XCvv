-- สแกนและดักฟังสัญญาณเซิร์ฟเวอร์ทั้งหมด
local function scanAndHookServerSignals()
    table.clear(DiscoveredRemotes)
    table.clear(RemoteNamesList)

    for _, container in ipairs({ReplicatedStorage, Workspace, PlayerGui}) do
        if container then
            for _, obj in ipairs(container:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    local fullName = obj.Name .. " [" .. obj.ClassName .. "]"
                    DiscoveredRemotes[fullName] = obj
                    table.insert(RemoteNamesList, fullName)

                    if obj:IsA("RemoteEvent") and not ConnectedListeners[obj] then
                        ConnectedListeners[obj] = obj.OnClientEvent:Connect(function(...)
                            if not BrickStudioConfig.ServerSignals.ListenSignals then return end
                            local args = {...}
                            local summary = ""
                            for i = 1, math.min(#args, 4) do
                                summary = summary .. tostring(args[i]) .. (i < math.min(#args, 4) and ", " or "")
                            end
                            print(string.format("[Brick Studio Signal] เซิร์ฟเวอร์ส่งสัญญาณ -> %s | ข้อมูล: %s", obj.Name, summary))

                            if BrickStudioConfig.ServerSignals.NotifyOnSignal then
                                local lower = string.lower(obj.Name .. summary)
                                if string.find(lower, "locust") or string.find(lower, "monster") or string.find(lower, "key") or string.find(lower, "pumpkin") or string.find(lower, "role") then
                                    sendBrickStudioNotification("📡 สัญญาณจากเซิร์ฟ: " .. obj.Name .. " (" .. summary .. ")", 3)
                                end
                            end
                        end)
                    end
                end
            end
        end
    end

    if #RemoteNamesList == 0 then
        table.insert(RemoteNamesList, "ไม่พบ RemoteEvent")
    elseif BrickStudioConfig.ServerSignals.SelectedRemoteName == "" then
        BrickStudioConfig.ServerSignals.SelectedRemoteName = RemoteNamesList[1]
    end
end

-- ดักจำแพ็กเกจล่าสุดที่ส่งไปเซิร์ฟเวอร์เพื่อทำ Auto-Replay
pcall(function()
    local env = (getfenv and getfenv()) or _G
    if typeof(env.hookmetamethod) == "function" and typeof(env.getnamecallmethod) == "function" then
        local oldNamecall
        oldNamecall = env.hookmetamethod(game, "__namecall", function(self, ...)
            local method = env.getnamecallmethod()
            if method == "FireServer" and self:IsA("RemoteEvent") then
