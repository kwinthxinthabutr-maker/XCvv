-- 6. ระบบ Ultra ESP Engine V5 (Hybrid Highlight + 3D BoxAdornment + Billboard + Beam)
-- เปิด-ปิดได้ทันที 100% ไม่ติดลิมิต 31 ชิ้นของ Roblox
-- ============================================================================
local ActiveESPRegistry = {} -- [Instance] = { Category, Highlight, BoxAdorn, Billboard, Label, Beam, TargetAtt }

local function getRootPart(target)
    if not target then return nil end
    if target:IsA("BasePart") then return target end
    if target:IsA("Model") then
        return target:FindFirstChild("HumanoidRootPart")
            or target.PrimaryPart
            or target:FindFirstChild("Handle")
            or target:FindFirstChild("Head")
            or target:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function removeESPObject(target)
    local data = ActiveESPRegistry[target]
    if data then
        pcall(function()
            if data.Highlight then data.Highlight.Enabled = false; data.Highlight:Destroy() end
        end)
        pcall(function()
            if data.BoxAdorn then data.BoxAdorn.Visible = false; data.BoxAdorn:Destroy() end
        end)
        pcall(function()
            if data.Billboard then data.Billboard.Enabled = false; data.Billboard:Destroy() end
        end)
        pcall(function()
            if data.Beam then data.Beam.Enabled = false; data.Beam:Destroy() end
        end)
        pcall(function()
            if data.TargetAtt then data.TargetAtt:Destroy() end
        end)
        ActiveESPRegistry[target] = nil
    end
end

local function clearESPCategory(categoryName)
    for target, data in pairs(ActiveESPRegistry) do
        if not categoryName or data.Category == categoryName then
            removeESPObject(target)
        end
    end
end

local function renderHybridESP(target, category, titleText, fillColor, outlineColor, useTracer)
    if not target or not target:IsDescendantOf(Workspace) then
        removeESPObject(target)
        return
    end

    local rootPart = getRootPart(target)
    if not rootPart or not rootPart:IsDescendantOf(Workspace) then
        removeESPObject(target)
        return
    end

    local data = ActiveESPRegistry[target]
    if data and data.Category ~= category then
        removeESPObject(target)
        data = nil
    end

    if not data then
        -- 1. Highlight เรืองแสงรอบโมเดล
        local hl = Instance.new("Highlight")
        hl.Name = "BS_HL_" .. category
        hl.Adornee = target
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillTransparency = (category == "Monster") and 0.25 or 0.5
        hl.OutlineTransparency = 0
        hl.Parent = ESPContainer

        -- 2. BoxHandleAdornment 3D ทะลุกำแพง (สำรองอัตโนมัติ ไม่จำกัดจำนวนชิ้นในแมพ)
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "BS_BOX_" .. category
        box.Adornee = rootPart
        box.AlwaysOnTop = true
        box.ZIndex = 5
        box.Size = (category == "Monster" or category == "Player") and Vector3.new(4, 5.5, 2) or (rootPart.Size + Vector3.new(0.4, 0.4, 0.4))
        box.Transparency = 0.55
        box.Parent = ESPContainer

        -- 3. ป้ายชื่อและระยะทาง (BillboardGui)
        local bb = Instance.new("BillboardGui")
        bb.Name = "BS_BB_" .. category
        bb.Adornee = rootPart
        bb.Size = UDim2.new(0, 230, 0, 50)
        bb.StudsOffset = (category == "Monster" or category == "Player") and Vector3.new(0, 4.2, 0) or Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        bb.Parent = ESPContainer

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextStrokeTransparency = 0.1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = (category == "Monster") and 14 or 12
        lbl.Parent = bb

        data = {
            Category = category,
            Highlight = hl,
            BoxAdorn = box,
            Billboard = bb,
            Label = lbl,
            Beam = nil,
            TargetAtt = nil
        }
        ActiveESPRegistry[target] = data
    end

    -- อัปเดตสถานะและสี
    data.Highlight.Adornee = target
    data.Highlight.FillColor = fillColor
    data.Highlight.OutlineColor = outlineColor
    data.Highlight.Enabled = true

    data.BoxAdorn.Adornee = rootPart
    data.BoxAdorn.Color3 = fillColor
    data.BoxAdorn.Visible = true

    data.Billboard.Adornee = rootPart
    data.Billboard.Enabled = true

    -- คำนวณระยะห่าง
    local dist = 0
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if myRoot then
        dist = math.floor((myRoot.Position - rootPart.Position).Magnitude)
    elseif Camera then
        dist = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
    end

    -- แสดงเลือดสำหรับตัวละคร
    local hpStr = ""
    if target:IsA("Model") then
        local hum = target:FindFirstChildOfClass("Humanoid")
        if hum and hum.MaxHealth > 0 then
            hpStr = string.format(" | ❤️ %d", math.floor(hum.Health))
        end
    end

    data.Label.TextColor3 = (category == "Monster") and outlineColor or fillColor
    data.Label.Text = string.format("%s\n[%d เมตร%s]", titleText, dist, hpStr)

    -- อัปเดตเส้นชี้เป้า (Beam Tracer)
    if useTracer and myRoot then
        local originAtt = myRoot:FindFirstChild("BS_OriginAtt")
        if not originAtt then
            originAtt = Instance.new("Attachment")
            originAtt.Name = "BS_OriginAtt"
            originAtt.Parent = myRoot
        end

        if not data.TargetAtt or data.TargetAtt.Parent ~= rootPart then
            if data.TargetAtt then pcall(function() data.TargetAtt:Destroy() end) end
            local tAtt = Instance.new("Attachment")
            tAtt.Name = "BS_TargetAtt"
            tAtt.Parent = rootPart
            data.TargetAtt = tAtt
        end

        if not data.Beam or not data.Beam.Parent then
            local beam = Instance.new("Beam")
            beam.Name = "BS_Beam_" .. category
            beam.FaceCamera = true
            beam.Color = ColorSequence.new(fillColor, outlineColor)
            beam.Width0 = 0.14
            beam.Width1 = 0.22
            beam.LightEmission = 1
            beam.Transparency = NumberSequence.new(0.15)
            beam.Parent = ESPContainer
            data.Beam = beam
        end

        data.Beam.Attachment0 = originAtt
        data.Beam.Attachment1 = data.TargetAtt
        data.Beam.Enabled = true
    else
        if data.Beam then
            data.Beam.Enabled = false
        end
    end
end

