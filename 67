local HeartbeatConn = RunService.Heartbeat:Connect(function(dt)
    if not BrickStudioConfig.Running then return end
    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if BrickStudioConfig.Movement.LockWalkSpeed and hum then
        hum.WalkSpeed = BrickStudioConfig.Movement.TargetWalkSpeed
    end

    if BrickStudioConfig.Movement.CFrameSpeedEnabled and hum and root then
        if hum.MoveDirection.Magnitude > 0 then
            root.CFrame = root.CFrame + (hum.MoveDirection * (BrickStudioConfig.Movement.CFrameSpeedPower * dt * 15))
        end
    end

    if BrickStudioConfig.ServerSignals.AntiFling and root then
        if root.AssemblyLinearVelocity.Magnitude > 120 or root.AssemblyAngularVelocity.Magnitude > 120 then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)

local SteppedConn = RunService.Stepped:Connect(function()
    if not BrickStudioConfig.Running then return end
    if BrickStudioConfig.Movement.Noclip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

