-- [สัญญาณเซิร์ฟเวอร์ที่ 3]: ส่งสัญญาณโจมตี/สตั๊นตัวประหลาดระยะไกล
local function triggerServerSignal3_Combat(silent)
    local targetMonster = CachedMonsters[1]
    if not targetMonster then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and isPlayerMonster(plr) then
                targetMonster = plr.Character
                break
            end
        end
    end

    local targetHum = targetMonster and targetMonster:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetMonster and getRootPart(targetMonster)

    if LocalPlayer.Character then
        for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
            if item:IsA("Tool") then
                pcall(function() item:Activate() end)
                for _, rem in ipairs(item:GetDescendants()) do
                    if rem:IsA("RemoteEvent") then
                        pcall(function()
                            if targetRoot and targetHum then
                                rem:FireServer(targetRoot.Position, targetRoot, targetHum)
                                rem:FireServer(targetHum)
                            else
                                rem:FireServer()
                            end
                        end)
                    end
                end
            end
        end
    end

    if targetRoot and targetHum then
        fireMatchingRemotes({"hit", "damage", "attack", "slash", "shoot", "fire", "stun", "punch", "swing"}, targetHum, targetRoot.Position)
    else
        fireMatchingRemotes({"hit", "damage", "attack", "slash", "shoot", "fire", "stun", "punch", "swing"})
    end

    if not silent then
        sendBrickStudioNotification("⚔️ [สัญญาณที่ 3] ส่งสัญญาณโจมตี/สตั๊นไปยังเซิร์ฟเวอร์แล้ว!", 3)
    end
end

